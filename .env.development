# 💻 Variables for DEVELOPMENT. <Last updated: 2026-03-23>
# Refer to `.env` for the complete list of variables and their descriptions.
# ------------------------------------------------------------------------------------
#
# This file is loaded when running:
#   ⚡️ Command           : dotenv -c development -- <command>
#   📂 Overridding order : .env -> .env.development -> .env.local -> .env.development.local

# ═════════════════════════════════════════════════════════╗
#                     App Variables                        ║
# ═════════════════════════════════════════════════════════╝


# ═════════════════════════════════════════════════════════╗
#                  Environment Settings                    ║
# ═════════════════════════════════════════════════════════╝
# Logical application environment
APP_ENV=development

# Node runtime mode
NODE_ENV=development

# Logging severity (minimum level to output)
LOG_LEVEL=trace

# Log output format (controls how logs are displayed)
LOG_FORMAT=pretty

# HTTP log detail
HTTP_LOG_DETAIL=simple

# ═════════════════════════════════════════════════════════╗
#                   Development Options                    ║
# ═════════════════════════════════════════════════════════╝
# Logs errors to stderr instead of throwing exceptions
TS_NODE_LOG_ERROR=true

# Silence annoying Node warning (e.g., MODULE_TYPELESS_PACKAGE_JSON)
NODE_NO_WARNINGS=1
