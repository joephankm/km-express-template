{
  "name": "km-express-template",
  "version": "1.1.0-runtime",
  "scripts": {
    "_env": "dotenv -c ${ENV=\"development\"}",
    "start": "pnpm run _env -- nodemon src/server",
    "script": "pnpm run _env -- ts-node --transpile-only --cwd scripts",
    "hello:script": "pnpm run script hello",
    "typecheck": "tsc --noEmit",
    "build": "tsc && tsc-alias",
    "prerun": "pnpm install --frozen-lockfile && rm -rf dist && pnpm run build",
    "server": "pnpm run _env -- node dist/server",
    "server:prod": "ENV=production pnpm run server",
    "server:stage": "ENV=staging pnpm run server"
  },
  "packageManager": "pnpm@11.3.0",
  "engines": {
    "node": ">=24.16.0"
  },
  "dependencies": {
    "dotenv-cli": "^11.0.0",
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@tsconfig/node24": "^24.0.4",
    "@types/express": "^5.0.6",
    "@types/node": "^25.9.1",
    "nodemon": "^3.1.14",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.8.17",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^6.0.3"
  },
  "author": "KM",
  "license": "MIT"
}
