{
  "name": "km-express-template",
  "version": "1.1.0-runtime",
  "scripts": {
    "_env": "dotenv -c ${ENV=\"development\"}",
    "start": "pnpm run _env -- nodemon src/server",
    "script": "pnpm run _env -- ts-node --transpile-only --cwd scripts",
    "hello:script": "pnpm run script hello",
    "format": "prettier . --write",
    "typecheck": "tsc --noEmit",
    "lint:es": "eslint .",
    "lint": "concurrently --prefix=none 'pnpm run lint:es' 'pnpm run typecheck'",
    "build": "tsc && tsc-alias",
    "prerun": "pnpm install --frozen-lockfile && rm -rf dist && pnpm run build",
    "server": "pnpm run _env -- node dist/server",
    "pm2": "pnpm run _env -- pm2 start ecosystem.config.cjs",
    "pm2:delete": "pnpm run _env -- pm2 delete ecosystem.config.cjs",
    "server:prod": "ENV=production pnpm run server",
    "pm2:prod": "ENV=production pnpm run pm2",
    "server:stage": "ENV=staging pnpm run server",
    "pm2:stage": "ENV=staging pnpm run pm2"
  },
  "packageManager": "pnpm@11.3.0",
  "engines": {
    "node": ">=24.16.0"
  },
  "dependencies": {
    "concurrently": "^9.2.1",
    "dotenv-cli": "^11.0.0",
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tsconfig/node24": "^24.0.4",
    "@types/express": "^5.0.6",
    "@types/node": "^25.9.1",
    "eslint": "^10.4.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-n": "^17.24.0",
    "globals": "^17.6.0",
    "nodemon": "^3.1.14",
    "prettier": "^3.8.3",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.8.17",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.4"
  },
  "author": "KM",
  "license": "MIT"
}
