{
  "name": "km-express-template",
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": ">=24.7.0"
  },
  "scripts": {
    "start": "node src/app",
    "build": "tsc",
    "format": "prettier --write './**/*.{ts,js,cjs,mjs,json}'",
    "typecheck": "tsc --noEmit",
    "lint:es": "eslint .",
    "lint": "concurrently --prefix=none 'pnpm run lint:es' 'pnpm typecheck'",
    "prepare": "node .husky/install.mjs"
  },
  "dependencies": {
    "concurrently": "^9.2.1",
    "express": "^5.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.37.0",
    "@types/express": "^5.0.3",
    "@types/node": "^24.6.2",
    "eslint": "^9.37.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-n": "^17.23.1",
    "globals": "^16.4.0",
    "husky": "^9.1.7",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.45.0"
  }
}
