# 🚀 Variables for PRODUCTION Environment ‼️️️‼️️️. <Last updated: 2026-03-23>
# Refer to `.env` for the complete list of variables and their descriptions.
# -----------------------------------------------------------------------------------
#
# This file is loaded when running:
#   ⚡️ Command           : dotenv -c production -- <command>
#   📂 Overridding order : .env -> .env.production -> .env.local -> .env.production.local

# ═════════════════════════════════════════════════════════╗
#                     App Variables                        ║
# ═════════════════════════════════════════════════════════╝


# ═════════════════════════════════════════════════════════╗
#                  Environment Settings                    ║
# ═════════════════════════════════════════════════════════╝
# Logical application environment
APP_ENV=production

# Application running port
PORT=8100
