# 🌳 Base Variables for All Environments. <Last updated: 2026-03-23>
# This env file contains definitions for all variables and will be used in all environments.
# It will take PRODUCTION values by default for environment variables.
# ------------------------------------------------------------------------------------------
#
# Variable Override Priority (dotenv-flow standard, from low to high):
#   development: .env -> .env.development -> .env.local -> .env.development.local
#   production : .env -> .env.production  -> .env.local -> .env.production.local
#   other env  : .env -> .env.<name>      -> .env.local -> .env.<name>.local
# See: https://github.com/kerimdzhanov/dotenv-flow/blob/master/README.md#variables-overwritingpriority

# ═════════════════════════════════════════════════════════╗
#                     App Variables                        ║
# ═════════════════════════════════════════════════════════╝
# Example
# KEY=VALUE            # [STRING|NUMBER|BOOLEAN|ENUM]

# ═════════════════════════════════════════════════════════╗
#                  Environment Settings                    ║
# ═════════════════════════════════════════════════════════╝
# Logical application environment (e.g., staging, test, sandbox)
APP_ENV=                 # [STRING]

# Application running port
PORT=8112                 # (NUMBER)

# Node runtime mode
NODE_ENV=production      # (ENUM: development | production | test>)

# File path to write all logs
LOG_FILE_PATH=           # [STRING: absolute or relative path, e.g. logs/app.log]

# File path to write error-level and above logs only
LOG_FILE_ERROR_PATH=     # [STRING: absolute or relative path, e.g. logs/error.log]

# ═════════════════════════════════════════════════════════╗
#                   Development Options                    ║
# ═════════════════════════════════════════════════════════╝
# Logs errors to stderr instead of throwing exceptions
#TS_NODE_LOG_ERROR=true
